/*INSERTING ANOTHER TABLE VALUES INTO A DIFFERENT TABLE*/

INSERT INTO salesdb.sales.customers (CustomerID,FirstName,Country,Score)
Select 
id,
first_name,
country,
score
from MyDatabase.dbo.customers as S
where not exists ( select * from salesdb.sales.customers as R
                   where S.id = R.CustomerID )

/* IMP- since id is a unique parameter. duplicate ID cannot be inserted into the table if it has constraints. So, WHERE NOT EXISTS syntax is used*/
